import requests

def retrieve_epic_photos(api_key, date):
    """Retrieve NASA EPIC photos for a specific date."""
    endpoint_url = f"https://api.nasa.gov/EPIC/api/natural/date/{date}"
    params = {"api_key": api_key}

    response = requests.get(endpoint_url, params=params)

    if response.status_code == 200:
        return response.json()
    else:
        print(f"Data not received. Status code: {response.status_code}")
        return None


def count_photos(photos):
    """Count the number of photos returned."""
    if photos is None or len(photos) == 0:
        return 0

    return len(photos)


def display_photo_info(photos):
    """Display information about the first photo."""
    if photos is None or len(photos) == 0:
        print("No photos available for this date.")
        return

    first_photo = photos[0]

    print("\nFirst photo information:")
    print("Date:", first_photo["date"])
    print("Image:", first_photo["image"])
    print("Centroid coordinates:", first_photo["centroid_coordinates"])


# Main program
api_key = "DEMO_KEY"
date = "2016-03-08"

photos = retrieve_epic_photos(api_key, date)

if photos is not None:
    total_photos = count_photos(photos)

    print("Date:", date)
    print("Number of photos:", total_photos)

    display_photo_info(photos)
